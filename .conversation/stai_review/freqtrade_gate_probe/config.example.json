{
  "bot_name": "stai-probe",
  "initial_state": "running",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 0.99,
  "last_stake_amount_min_ratio": 0.5,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 400,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "password": "",
    "ccxt_config": {
      "options": {
        "fetchMarkets": {
          "types": [
            "spot",
            "swap"
          ]
        }
      }
    },
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8181,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "SET_VIA_SECRET",
    "ws_token": "SET_VIA_SECRET",
    "CORS_origins": [],
    "username": "SET_VIA_SECRET",
    "password": "SET_VIA_SECRET"
  },
  "force_entry_enable": true,
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  "internals": {
    "process_throttle_secs": 5
  }
}
