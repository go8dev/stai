# Set through Replit Secrets only; never put the value in this file.
OPENAI_API_KEY=
# Historical AI review stays disabled until model and spending limits are authorized.
STAI_HISTORICAL_REVIEW_ENABLED=false
STAI_HISTORICAL_REVIEW_MODEL=
STAI_HISTORICAL_REVIEW_PER_RUN_CAP_USD=
STAI_HISTORICAL_REVIEW_DAILY_CAP_USD=
STAI_HISTORICAL_REVIEW_INPUT_USD_PER_MILLION=
STAI_HISTORICAL_REVIEW_OUTPUT_USD_PER_MILLION=
# STAI environment reference.
#
# This file holds no real values and nothing loads it: STAI reads the process
# environment only. On Replit the values come from the platform, the artifact
# configuration and Replit Secrets. See docs/ENVIRONMENT.md for what each one means.
#
# Never put a real value in this file. An empty value counts as not set.

# --- Runtime ---------------------------------------------------------------------------
# development or production. Not set means production.
STAI_ENV=
# Set to 1 by Replit on a published machine. Do not set it yourself.
REPLIT_DEPLOYMENT=
# Port the backend listens on. Set by the artifact configuration.
PORT=8080
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default INFO.
STAI_LOG_LEVEL=INFO
# Optional. Commit shown on the system status screen.
STAI_BUILD_COMMIT=

# --- Database --------------------------------------------------------------------------
# Provided by Replit. Contains a password: never copy the real one anywhere.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Sign-in ---------------------------------------------------------------------------
# Provided by Replit.
REPL_ID=
# Optional. Default https://replit.com/oidc
ISSUER_URL=https://replit.com/oidc
# Optional. The one account that may sign in. Takes priority over REPL_OWNER_ID.
STAI_OWNER_USER_ID=
# Provided by Replit in the workspace.
REPL_OWNER_ID=
# Optional. Hours a sign-in lasts, 1 to 2160. Default 168.
STAI_SESSION_TTL_HOURS=168

# --- Hosts -----------------------------------------------------------------------------
# Provided by Replit.
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=
# Optional. Extra comma-separated hosts, for example a custom domain.
STAI_ALLOWED_HOSTS=

# --- Market data (public endpoints, no keys) -------------------------------------------
# Optional. Default https://www.okx.com
STAI_OKX_BASE_URL=https://www.okx.com

# --- Web app (build and development server only) ---------------------------------------
# Set by the artifact configuration.
# PORT=21943
# BASE_PATH=/

# --- Replit Secrets (names only) -------------------------------------------------------
# Values must be entered in Replit Secrets, never in this file.
# OPENAI_API_KEY      model provider for the AI committee and authorized historical reviews
# STAI_ALERT_EMAIL    address that receives alerts (Phase 4)
#
# There is no variable for exchange API keys and none that switches trading mode.
# STAI is paper trading only.
